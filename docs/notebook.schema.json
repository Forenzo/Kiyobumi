{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opennotebook:schema:4",
  "title": "Kiyobumi manifest or page v1/v2/v3/v4",
  "$defs": {
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "colorHex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "pageIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "colorHex",
        "pageIDs"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "pressure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "pressure"
      ],
      "additionalProperties": false
    },
    "stroke": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "pen",
            "highlighter"
          ]
        },
        "colorHex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "kind",
        "colorHex",
        "width",
        "points"
      ],
      "additionalProperties": false
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "markdown": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "markdown"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "richText"
            },
            "value": {
              "$ref": "#/$defs/richValue"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ink"
            },
            "strokes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/stroke"
              }
            }
          },
          "required": [
            "type",
            "strokes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "image"
            },
            "mediaName": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!\\.{1,2}$)[^/\\\\]+$"
            }
          },
          "required": [
            "type",
            "mediaName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "attachment"
            },
            "mediaName": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!\\.{1,2}$)[^/\\\\]+$"
            },
            "fileName": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "mediaName",
            "fileName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "table"
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "type",
            "rows"
          ],
          "additionalProperties": false
        }
      ]
    },
    "element": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "minimumHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "tableColumnWidths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          }
        }
      },
      "required": [
        "id",
        "frame",
        "content"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "format": {
          "const": "org.opennotebook.notebook"
        },
        "schemaVersion": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "id",
        "name",
        "sections"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "modifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "background": {
          "enum": [
            "plain",
            "ruled",
            "grid"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "createdAt",
        "modifiedAt",
        "elements"
      ],
      "additionalProperties": false
    },
    "textFormat": {
      "type": "object",
      "properties": {
        "fontName": {
          "type": "string",
          "minLength": 1
        },
        "fontSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 288
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "colorHex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "link": {
          "type": "string",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:|^[Mm][Aa][Ii][Ll][Tt][Oo]:"
        },
        "highlightHex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "fontName",
        "fontSize",
        "bold",
        "italic",
        "underline",
        "colorHex"
      ],
      "additionalProperties": false
    },
    "textSpan": {
      "type": "object",
      "properties": {
        "location": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "$ref": "#/$defs/textFormat"
        }
      },
      "required": [
        "location",
        "length",
        "format"
      ],
      "additionalProperties": false
    },
    "richValue": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "runs": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/textSpan"
          }
        },
        "defaultFormat": {
          "$ref": "#/$defs/textFormat"
        }
      },
      "required": [
        "text",
        "runs",
        "defaultFormat"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/page"
    }
  ]
}
